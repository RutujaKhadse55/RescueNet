{
  "name": "@rescuenet/api",
  "version": "0.1.0",
  "private": true,
  "description": "RescueNet Fastify REST and WebSocket ingestion API with PostGIS geospatial database",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "clean": "rimraf dist",
    "migrate:up": "node-pg-migrate --envPath ../../.env --migrations-dir migrations up",
    "migrate:down": "node-pg-migrate --envPath ../../.env --migrations-dir migrations down",
    "migrate:dry-run": "node-pg-migrate --envPath ../../.env --migrations-dir migrations --dry-run up",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.0.0",
    "@rescuenet/core": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
