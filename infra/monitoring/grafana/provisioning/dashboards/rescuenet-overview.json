{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Ingested Packets Rate (pkts/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{path=\"/v1/uplink\"}[1m])",
          "legendFormat": "Uplink Ingestion"
        },
        {
          "expr": "rate(http_requests_total{path=\"/v1/sms/webhook\"}[1m])",
          "legendFormat": "SMS Webhook Ingestion"
        }
      ]
    },
    {
      "title": "p95 API Ingestion Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "http_request_duration_seconds{quantile=\"0.95\"} * 1000",
          "legendFormat": "{{path}} p95"
        }
      ]
    },
    {
      "title": "Active Rescuer WebSockets & Dispatchers",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rescuenet_active_websocket_connections",
          "legendFormat": "Active Sockets"
        }
      ]
    },
    {
      "title": "Database Connection Pool Utilization",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "(pgbouncer_used_clients / pgbouncer_max_clients) * 100",
          "legendFormat": "PgBouncer %"
        }
      ]
    },
    {
      "title": "Banned Key Rejection Rate (pkts/sec)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(rescuenet_banned_key_rejections_total[1m])",
          "legendFormat": "Banned Packets Dropped"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["rescuenet", "telemetry", "control-room"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "RescueNet Control Room Health & Ingestion Telemetry",
  "version": 1
}
