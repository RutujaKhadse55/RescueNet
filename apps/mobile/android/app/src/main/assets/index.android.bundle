2\u0ca6\u0cb2\u0cc1.','perm.location_title':'GPS \u0cb8\u0ccd\u0ca5\u0cb3','perm.location_desc':'\u0cb8\u0ccd\u0ca5\u0cb3 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0ccd\u0cb2\u0cc2\u0c9f\u0cc2\u0ca4\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1.','perm.notif_title':'\u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1','perm.notif_desc':'\u0cb8\u0c82\u0ca6\u0cc7\u0cb6 \u0cac\u0c82\u0ca6\u0cbe\u0c97 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1.','perm.sms_title':'SMS \u0cac\u0ccd\u0caf\u0cbe\u0c95\u0caa\u0ccd','perm.sms_desc':'\u0cae\u0cc6\u0cb6\u0ccd \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0c97 SMS \u0cae\u0cc2\u0cb2\u0c95 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1.','perm.battery_title':'\u0cac\u0ccd\u0caf\u0cbe\u0c9f\u0cb0\u0cbf \u0cb0\u0cbf\u0caf\u0cbe\u0caf\u0cbf\u0ca4\u0cbf','perm.battery_desc':'\u0cb9\u0cbf\u0ca8\u0ccd\u0ca8\u0cc6\u0cb2\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cb2\u0cc1.','perm.grant_btn':'\u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf','perm.open_settings':'\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u0cb8\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf'}}},524,[]);
