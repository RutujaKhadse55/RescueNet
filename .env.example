# ==============================================================================
# RescueNet Environment Configuration (.env.example)
# All sensitive credentials and network endpoints must be defined here.
# ==============================================================================

# Database Connection (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL=postgresql://rescuenet:rescuenet_secret@localhost:5432/rescuenet

# JWT Secret for Rescuer / Gateway Authentication (min 32 characters)
JWT_SECRET=super_secret_rescuenet_jwt_signing_key_32_bytes_min_length_value

# National/State Disaster Agency Root Public Key (Ed25519 Base64)
# Used to verify offline digital certificates issued to rescuers
AGENCY_CA_PUBLIC_KEY=MCowBQYDK2VwAyEAx5d3v90oP9zP+6U6r3N6LhHh5k2f1W9r5Q3j8K9d2A4=

# SMS Transport Provider ("mock" | "twilio" | "msg91" | "custom_webhook")
SMS_PROVIDER=mock

# SMS Webhook HMAC Secret for verifying inbound webhook payloads from SMS gateway
SMS_WEBHOOK_SECRET=rescuenet_inbound_sms_hmac_secret_key_998877

# Emergency Inbound Virtual Phone Number (E.164 format)
SMS_INBOUND_NUMBER=+911123456789

# Incident Data Retention Period (in days before automated PII/chat purging)
RETENTION_DAYS=30

# Public Base URL for API Gateway and WebSockets
API_PUBLIC_URL=http://localhost:3000

# Dashboard Port & Host
DASHBOARD_PORT=5173
API_PORT=3000

# Map Tiles & Tactical Map API Key (Frontend Vite client)
# Used by CartoDB, MapTiler, Stadia Maps, or Mappls
VITE_MAPS_API_KEY=your_maps_api_key_here
# Optional custom tile server template URL:
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
